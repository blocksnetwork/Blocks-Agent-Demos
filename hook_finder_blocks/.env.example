# Copy to .env and fill in. Never commit the filled-in file.

# Blocks API key — set via 'blocks login --write-env' or paste from the dashboard.
BLOCKS_API_KEY=

# Transcription service (faster-whisper). See deploy/whisper/.
WHISPER_URL=http://127.0.0.1:8001/transcribe

# vLLM server that ranks the transcript into clips.
VLLM_URL=http://127.0.0.1:8000/v1/chat/completions
VLLM_MODEL=Qwen/Qwen3.5-4B
