# Copy to .env and fill in. Never commit the filled-in file.

# Blocks API key — set via 'blocks login --write-env' or paste from the dashboard.
BLOCKS_API_KEY=

# Where the handler and the ingest tagger reach the local vLLM server
# (shared with plant_doctor / clip_scout).
VLLM_URL=http://localhost:8000/v1/chat/completions

# The model vLLM is serving.
VLLM_MODEL=Qwen/Qwen3.5-4B

# Optional hosted authoring model. With a key, Claude writes the product
# intent, the three directions, every CompositionSpec and the critique;
# the local vLLM model above becomes the fallback for any failed call.
# Without a key everything runs on the local open-weights model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Set to 'local' to ignore the key and force the local model.
DESIGN_LLM=

# The embedding sidecar (deploy/embed). CPU-only, localhost.
EMBED_URL=http://127.0.0.1:8798

# Hero imagery is retrieval-first: the bank photograph matched to the
# brief, gradient-mapped to each direction's palette (no GPU). Set
# DESIGN_IMAGINE=1 to try the optional diffusion sidecar (deploy/imagine)
# first; it needs ~2.5GB of free VRAM.
DESIGN_IMAGINE=
IMAGINE_URL=http://127.0.0.1:8797

# Where downloaded TTFs for comp rendering are cached.
FONT_CACHE_DIR=./fonts-cache

# Where the reference bank lives, relative to the agent's working directory.
BANK_DIR=./bank

# Soft deadline (ms) for one task — the handler sheds work (extra critique
# rounds, per-direction imagery, extra transfers) as it approaches this,
# and records every shed in kit.provenance. Keep below maxRunningTimeSec.
DESIGN_TASK_BUDGET_MS=380000

# Vision critique rounds on the winning composition (0-2, default 1).
DESIGN_CRITIQUE_ROUNDS=1

# Weight of the craft-proxy scalar in the score blend (0-0.2, default 0).
# STAYS 0 until the W2-4 calibration report recommends a value — the P4
# gate: proxies are measured and logged on every run, but parts.craft is
# null until calibration, so this weight is inert either way.
DESIGN_CRAFT_WEIGHT=0

# Optional: lets ingest/seed-pexels.ts fill the bank with licensed photos,
# and adds a matched stock photo to each kit. The agent runs without it.
PEXELS_API_KEY=

# Set to 1 to skip outbound asset fetches (icons, photos) — for demos on
# hostile wifi. Fonts, tokens, and the bank itself are local regardless.
DESIGN_BLOCKS_OFFLINE=
