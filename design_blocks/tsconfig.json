{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["handler.ts", "trigger.ts", "lib/**/*.ts", "ingest/**/*.ts", "test/**/*.ts", "tools/**/*.ts"]
}
